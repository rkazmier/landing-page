{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "accommodation.schema.json",
  "title": "Noclegi i atrakcje w pobliżu strzelnicy (FR-7)",
  "description": "Lista pozycji wyświetlanych w sekcji „Noclegi i atrakcje”. Kolejność na stronie wynika z pola distance_km (od najbliższej).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "name", "place", "distance_km", "description"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "Stały identyfikator (małe litery, cyfry, myślniki)"
      },
      "type": {
        "enum": ["stay", "attraction"],
        "description": "stay = nocleg, attraction = atrakcja"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Nazwa własna (nie tłumaczona)"
      },
      "place": {
        "type": "string",
        "minLength": 1,
        "description": "Miejscowość"
      },
      "distance_km": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 50,
        "description": "Odległość od strzelnicy w kilometrach (w linii prostej)"
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "description": "Opcjonalny link do strony obiektu (tylko https)"
      },
      "description": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pl", "en", "de", "lt", "cs", "sk"],
        "properties": {
          "pl": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 },
          "de": { "type": "string", "minLength": 1 },
          "lt": { "type": "string", "minLength": 1 },
          "cs": { "type": "string", "minLength": 1 },
          "sk": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
