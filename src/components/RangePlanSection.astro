---
/**
 * Sekcja „Plan przedpola” (FR-5, ADR 0003, Z07).
 *
 * - Plan (SVG) i tabela powstają w czasie budowania z src/data/targets.json — bez JavaScriptu
 *   w przeglądarce. Dodanie, usunięcie lub zmiana celu = edycja wyłącznie targets.json.
 * - Geometria i układ etykiet: src/utils/rangePlan.ts; rysunek: RangePlanSvg.astro (osobny egzemplarz
 *   na ekran i na wydruk); znaczniki kształtów: TargetShape.astro.
 * - Oś strzału w pionie (linia otwarcia ognia na dole), prawy wał (x = 0) po prawej, lewy (160 m) po lewej.
 *   Skale pozioma i pionowa są różne; bez podziałki i opisu osi X (decyzja właściciela).
 * - Tabela: oznaczenie, kształt, odległość, rozmiar.
 * - Kształty odróżnia obrys, nie kolor. Cele z tą samą literą `label` (np. S1, S2, S3) to grupa stojąca
 *   obok siebie: rząd znaczników na dystansie i w miejscu pierwszego celu, litera (S) raz po lewej
 *   (decyzja właściciela z 2026-11-11). Pełne oznaczenia są w tabeli; wartości nietłumaczone.
 * - Wydruk (FR-6, Z08): przycisk „Drukuj plan” dodaje do <html> klasę `print-plan` i otwiera okno
 *   drukowania — wtedy drukowana jest tylko ta sekcja (reguły w src/styles/base.css i poniżej).
 *   Na wydruku: plan (60 mm szerokości, rozciągnięty w pionie na całą stronę) i tabela; bez tytułu sekcji, wstępu i legendy, marginesy strony 0.
 *   W tabeli na wydruku oznaczenie, sam symbol kształtu (bez nazwy) i odległość są w jednej kolumnie
 *   (decyzja właściciela z 2026-11-11) — osobna komórka `.print-only`, na ekranie ukryta.
 *   Przycisk jest ukryty bez JavaScriptu; skrypt poniżej to jedyny JavaScript tej funkcji.
 * - Teksty: klucz `plan` w src/i18n/<kod>.json.
 */
import Section from './Section.astro';
import TargetShape from './TargetShape.astro';
import RangePlanSvg from './RangePlanSvg.astro';
import targetsData from '../data/targets.json';
import { t, type Locale } from '../i18n';
import { SHAPES, type Target } from '../utils/rangePlan';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const d = t(locale);
const p = d.plan;

const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
const num = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 });
const n = (value: number) => num.format(value);

const targets = targetsData as Target[];

function sizeText(target: Target): string {
  const s = target.size_cm;
  if (typeof s === 'number') {
    if (target.shape === 'circle') return fill(p.sizeDiameter, { v: n(s) });
    if (target.shape === 'silhouette' || target.shape === 'bust') return fill(p.sizeHeight, { v: n(s) });
    return fill(p.sizeSide, { v: n(s) });
  }
  if (target.shape === 'other') return fill(p.sizeOther, { name: s.name ?? '', w: n(s.width), h: n(s.height) });
  return fill(p.sizeWidthHeight, { w: n(s.width), h: n(s.height) });
}

const captionId = `${id}-table-caption`;
---
<Section id={id} title={d.sections.plan} tone="alt">
  <div class="plan-head">
    <p class="plan-intro">{p.intro}</p>
    <button type="button" class="print-button" data-print-plan hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M7 3h10v5H7z M5 9h14a2 2 0 0 1 2 2v6h-4v4H7v-4H3v-6a2 2 0 0 1 2-2z M9 15v4h6v-4z" fill-rule="evenodd" />
      </svg>
      {p.printButton}
    </button>
  </div>

  <div class="plan">
    <figure class="plan-figure">
      <RangePlanSvg id={id} locale={locale} class="plan-svg plan-svg--screen" />
      <RangePlanSvg id={id} locale={locale} print class="plan-svg plan-svg--print" />
    </figure>

    <div class="plan-side">
      <h3>{p.legendTitle}</h3>
      <ul class="legend">
        {SHAPES.map((shape) => (
          <li>
            <svg class="legend-icon" viewBox="-10 -10 20 20" width="20" height="20" aria-hidden="true" focusable="false">
              <TargetShape shape={shape} size={16} />
            </svg>
            <span>{p.shapes[shape]}</span>
          </li>
        ))}
      </ul>

      <section class="table-wrap" aria-labelledby={captionId} tabindex="0">
        <table class="targets-table">
          <caption id={captionId}>{p.tableCaption}</caption>
          <thead>
            <tr>
              <th scope="col" class="print-only">{p.colLabel}</th>
              <th scope="col" class="screen-only">{p.colLabel}</th>
              <th scope="col" class="screen-only">{p.colShape}</th>
              <th scope="col" class="screen-only">{p.colDistance}</th>
              <th scope="col">{p.colSize}</th>
            </tr>
          </thead>
          <tbody>
            {targets.map((target) => (
              <tr>
                <th scope="row" class="label-cell print-only">
                  <span class="combined-cell">
                    <span>{target.label}</span>
                    <svg class="legend-icon" viewBox="-10 -10 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                      <TargetShape shape={target.shape} size={16} />
                    </svg>
                    <span class="num">{n(target.distance_m)} m</span>
                  </span>
                </th>
                <th scope="row" class="label-cell screen-only">{target.label}</th>
                <td class="screen-only">
                  <span class="shape-cell">
                    <svg class="legend-icon" viewBox="-10 -10 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                      <TargetShape shape={target.shape} size={16} />
                    </svg>
                    {p.shapes[target.shape]}
                  </span>
                </td>
                <td class="num screen-only">{n(target.distance_m)} m</td>
                <td>{sizeText(target)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </div>
  </div>
</Section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-print-plan]');
  if (button) {
    const root = document.documentElement;
    button.hidden = false;
    button.addEventListener('click', () => {
      root.classList.add('print-plan');
      window.print();
    });
    window.addEventListener('afterprint', () => root.classList.remove('print-plan'));
  }
</script>

<style>
  .plan-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
  }

  .plan-intro {
    max-width: 60ch;
    margin-bottom: 0;
  }

  .print-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-5);
    color: var(--color-surface);
    background: var(--color-accent);
    font: inherit;
    font-weight: var(--font-weight-strong);
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .print-button[hidden] {
    display: none;
  }

  .print-button:hover {
    background: var(--color-accent-hover);
  }

  .print-button svg {
    fill: currentColor;
  }

  .plan {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  .plan-figure {
    margin: 0;
    min-width: 0;
  }

  .plan-figure :global(.plan-svg) {
    display: block;
    width: 100%;
    max-width: 24rem;
    height: auto;
    margin-inline: auto;
  }

  .plan-figure :global(.plan-svg--print) {
    display: none;
  }

  .plan-side {
    min-width: 0;
  }

  .plan-side h3 {
    margin-bottom: var(--space-3);
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legend-icon {
    flex: none;
    fill: var(--color-accent);
  }

  .table-wrap {
    max-width: 100%;
    overflow-x: auto;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .targets-table caption {
    padding: var(--space-3) var(--space-4);
    font-weight: var(--font-weight-strong);
    text-align: left;
  }

  .targets-table th,
  .targets-table td {
    padding: var(--space-2) var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .targets-table thead th {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-strong);
  }

  .targets-table .label-cell {
    font-weight: var(--font-weight-strong);
    white-space: nowrap;
  }

  .targets-table .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .targets-table .print-only {
    display: none;
  }

  .shape-cell,
  .combined-cell {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }

  @media (min-width: 56em) {
    .plan {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
      gap: var(--space-7);
    }
  }

  /* ---- Wydruk (Z08): A4, czerń i biel — kształty i wzory zamiast kolorów ---- */
  @media print {
    .plan-head {
      display: block;
    }

    /* Na wydruku bez tytułu sekcji, wstępu i legendy (decyzja właściciela) */
    .plan-intro,
    .plan-side h3,
    .legend {
      display: none;
    }

    .plan {
      grid-template-columns: 60mm minmax(0, 1fr);
      align-items: start;
      gap: 6mm;
      margin-top: 0;
    }

    .plan-figure {
      break-inside: avoid;
    }

    /* Na wydruku osobny rysunek: 60 mm szerokości, rozciągnięty w pionie na całą stronę (FIELD_H_PRINT) */
    .plan-figure :global(.plan-svg--screen) {
      display: none;
    }

    .plan-figure :global(.plan-svg--print) {
      display: block;
      width: 60mm;
      height: auto;
      max-width: none;
      margin: 0;
    }

    .targets-table .legend-icon {
      fill: #000;
    }

    .table-wrap {
      overflow: visible;
      border: 0;
      border-radius: 0;
    }

    .targets-table {
      font-size: 9pt;
    }

    .targets-table caption {
      padding: 0 0 2mm;
    }

    .targets-table th,
    .targets-table td {
      padding: 1.2mm 2mm;
      border: 0.3mm solid #000;
      color: #000;
    }

    .targets-table tr {
      break-inside: avoid;
    }

    /* Oznaczenie, symbol i odległość w jednej kolumnie (decyzja właściciela z 2026-11-11) */
    .targets-table .screen-only {
      display: none;
    }

    .targets-table .print-only {
      display: table-cell;
    }

    /* Kolumny wyrównane: oznaczenie | symbol | odległość (do prawej) */
    .combined-cell {
      display: grid;
      grid-template-columns: 2.6em 4mm 4.5em;
      align-items: center;
      gap: 2mm;
    }

    .combined-cell .num {
      text-align: right;
    }

    .combined-cell .legend-icon {
      width: 4mm;
      height: 4mm;
    }
  }
</style>
