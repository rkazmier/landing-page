---
/**
 * Sekcja „Dyscypliny" (FR-3): lista wspieranych dyscyplin z krótkim opisem.
 * Teksty: klucz `disciplines` w src/i18n/<kod>.json (oznaczone `todo` do podmiany).
 * Liczba i kolejność pozycji wynikają z pliku tłumaczeń — muszą być takie same w każdym języku (CI).
 * Pole `id` jest stałe we wszystkich językach (nie tłumaczymy go).
 */
import Section from './Section.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const d = t(locale);

/** Karty szerokie na dwie kolumny na desktopie (wyróżnione) */
const WIDE = new Set(['nrl-hunter']);
---
<Section id={id} title={d.sections.disciplines}>
  <p class="intro">{d.disciplines.intro}</p>
  <ul class="disciplines">
    {d.disciplines.items.map((item) => (
      <li class:list={['discipline', { 'discipline--wide': WIDE.has(item.id) }]}>
        <h3>{item.name}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .intro {
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }

  .disciplines {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .discipline {
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .discipline h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-h3);
  }

  .discipline p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 40em) {
    .disciplines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .disciplines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .discipline--wide {
      grid-column: span 2;
    }
  }
</style>
