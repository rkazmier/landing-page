---
/**
 * Szkielet sekcji strony: kotwica (id), nagłówek h2 i treść ze slotu.
 * `tone="alt"` daje naprzemienne tło.
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  tone?: 'default' | 'alt';
}

const { id, title, eyebrow, tone = 'default' } = Astro.props;
const headingId = `${id}-title`;
---
<section id={id} class:list={['section', { 'section--alt': tone === 'alt' }]} aria-labelledby={headingId}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={headingId}>{title}</h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
  }

  .section--alt {
    background: var(--color-surface-alt);
  }
</style>
