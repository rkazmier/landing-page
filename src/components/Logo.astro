---
/**
 * Logo: znak graficzny z src/brand.ts (opcjonalnie z logotypem tekstowym obok)
 * albo — gdy `brand.logo` jest puste — sam logotyp tekstowy.
 */
import { brand } from '../brand';

const logo = brand.logo;
const showWordmark = !logo || logo.withWordmark;
---
<span class="logo">
  {logo && (
    <img
      class="logo-mark"
      src={logo.mark.src}
      width={logo.mark.width}
      height={logo.mark.height}
      alt={showWordmark ? '' : brand.name}
    />
  )}
  {showWordmark && (
    <span class="wordmark">
      <span class="wordmark-primary">{brand.wordmark.primary}</span>
      {' '}
      <span class="wordmark-secondary">{brand.wordmark.secondary}</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo-mark {
    display: block;
    height: 2.5rem;
    width: auto;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.1;
    color: var(--color-text);
  }

  .wordmark-primary {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-strong);
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }

  .wordmark-secondary {
    margin-top: 2px;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
