---
/**
 * Logo: obraz z src/brand.ts albo (domyślnie) logotyp tekstowy.
 */
import { brand } from '../brand';
import { withBase } from '../utils/url';
---
{brand.logo ? (
  <img
    class="logo-img"
    src={withBase(brand.logo.src)}
    width={brand.logo.width}
    height={brand.logo.height}
    alt={brand.name}
  />
) : (
  <span class="wordmark">
    <span class="wordmark-primary">{brand.wordmark.primary}</span>
    {' '}
    <span class="wordmark-secondary">{brand.wordmark.secondary}</span>
  </span>
)}

<style>
  .logo-img {
    height: 2.5rem;
    width: auto;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.1;
    color: var(--color-text);
  }

  .wordmark-primary {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-strong);
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }

  .wordmark-secondary {
    margin-top: 2px;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
