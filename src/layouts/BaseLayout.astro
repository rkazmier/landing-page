---
/**
 * Układ bazowy: <head> (hreflang, canonical, meta SEO, Open Graph, Twitter Cards, JSON-LD — Z11),
 * baner językowy, link „przejdź do treści",
 * nagłówek z przełącznikiem języka, <main>, miejsce na stopkę.
 * Wszystkie teksty interfejsu pochodzą ze słownika danej wersji (src/i18n/).
 */
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import { defaultLocale, localePath, locales, t, type Locale } from '../i18n';
import type { NavItem } from '../types';
import { withBase } from '../utils/url';
import { keywords, ogLocales, structuredData } from '../seo';
import { brand } from '../brand';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  nav: NavItem[];
  /** Kotwica stopki (cel linku „Kontakt" w nawigacji) */
  footerId?: string;
  /**
   * Strona indeksowana (domyślnie tak). `false` — np. strona 404: `noindex`,
   * bez canonical, hreflang, Open Graph i danych strukturalnych.
   */
  indexable?: boolean;
}

const { locale, title, description, nav, footerId = 'kontakt', indexable = true } = Astro.props;
const ui = t(locale).ui;

// Adresy bezwzględne z jednej konfiguracji `site` + `base` (astro.config.mjs)
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(localePath(locale));
const alternates = [
  ...locales.map((code) => ({ hreflang: code, href: absolute(localePath(code)) })),
  { hreflang: 'x-default', href: absolute(localePath(defaultLocale)) },
];
const jsonLd = JSON.stringify(
  structuredData({ url: canonical, homeUrl: absolute(localePath(defaultLocale)), description }),
).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <Fragment>
        <meta name="keywords" content={keywords.join(', ')} />
        <link rel="canonical" href={canonical} />
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={brand.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={ogLocales[locale]} />
        {locales.filter((code) => code !== locale).map((code) => (
          <meta property="og:locale:alternate" content={ogLocales[code]} />
        ))}
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <script type="application/ld+json" set:html={jsonLd} />
      </Fragment>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <Fonts />
  </head>
  <body>
    <a class="skip-link" href="#tresc">{ui.skipLink}</a>
    <LanguageBanner locale={locale} />
    <Header
      items={nav}
      navLabel={ui.navLabel}
      menuLabel={ui.menuLabel}
      homeLabel={ui.homeLabel}
      homeHref={localePath(locale)}
      locale={locale}
    />
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    {Astro.slots.has('footer') && (
      <footer id={footerId} class="site-footer">
        <div class="container">
          <slot name="footer" />
        </div>
      </footer>
    )}
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .site-footer {
    padding-block: var(--space-7);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .site-footer :global(a) {
    color: var(--color-on-dark);
  }
</style>
